{
    "name": "verifyid/verifyid-php",
    "description": "Officiel PHP-klient til VerifyID: eID-login med MitID, kontrakter til digital underskrift og webhooks.",
    "type": "library",
    "license": "MIT",
    "keywords": ["verifyid", "mitid", "eid", "kyc", "kontrakt", "underskrift", "webhook"],
    "homepage": "https://kyc.verifyid.dk/api-dokumentation",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "guzzlehttp/guzzle": "^7.8",
        "nyholm/psr7": "^1.8"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Bruges automatisk som HTTP-klient, hvis den er installeret. Ellers giver du selv en PSR-18-klient og PSR-17-fabrikker til Client."
    },
    "autoload": {
        "psr-4": {
            "VerifyID\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VerifyID\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
